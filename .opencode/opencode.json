{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.79",
        "--browser",
        "chrome",
        "--isolated"
      ],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions"
      }
    },
    "sqlserver": {
      "type": "local",
      "command": ["npx", "-y", "mcpql@1.1.0"],
      "enabled": false,
      "environment": {
        "DB_AUTHENTICATION_TYPE": "{env:FASTGUY_DB_AUTHENTICATION_TYPE}",
        "DB_SERVER": "{env:FASTGUY_DB_SERVER}",
        "DB_NAME": "{env:FASTGUY_DB_NAME}",
        "DB_USER": "{env:FASTGUY_DB_USER}",
        "DB_PASSWORD": "{env:FASTGUY_DB_PASSWORD}",
        "DB_PORT": "{env:FASTGUY_DB_PORT}",
        "DB_ENCRYPT": "{env:FASTGUY_DB_ENCRYPT}",
        "DB_TRUST_SERVER_CERTIFICATE": "{env:FASTGUY_DB_TRUST_SERVER_CERTIFICATE}",
        "DB_ALLOW_MODIFICATIONS": "false",
        "DB_ALLOW_STORED_PROCEDURES": "false"
      }
    },
    "ecc-memory-vault": {
      "type": "local",
      "command": ["ecc-memory-mcp"],
      "enabled": true,
      "environment": {
        "ECC_MEMORY_HARNESS": "opencode"
      }
    }
  }
}
